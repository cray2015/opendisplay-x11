#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 vibhanshu
# SPDX-License-Identifier: GPL-3.0-or-later
include /usr/share/dpkg/pkg-info.mk
export PYBUILD_NAME=odx11

%:
	dh $@ --with python3 --buildsystem=pybuild

# The unit tests need no X server, iPad or GPU; run them from the source tree.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	PYTHONPATH=$(CURDIR) python3 -m pytest -q tests/
	desktop-file-validate packaging/io.github.cray2015.OpenDisplayX11.desktop
	appstreamcli validate --no-net packaging/io.github.cray2015.OpenDisplayX11.metainfo.xml
endif

# The running daemon watches this file and restarts onto the new version after an upgrade.
override_dh_install:
	dh_install
	mkdir -p debian/opendisplay-x11/usr/share/opendisplay-x11
	echo "$(DEB_VERSION)" > debian/opendisplay-x11/usr/share/opendisplay-x11/VERSION
	PYTHONPATH=$(CURDIR) python3 -c 'from odx11.upgrade import fingerprint; print(fingerprint("."))' \
		> debian/opendisplay-x11/usr/share/opendisplay-x11/SERVICE
