# opendisplay-x11 (PROJECT_SPEC.md §8.7): let members of plugdev (on Debian-family systems: the account made at OS install) force an HDMI
# connector on/off without root, by making its sysfs `status` attribute group-writable —
# the same pattern distributions use for backlight brightness. DP connectors are never
# covered: forcing them fails link training. Any X client can already switch monitors with
# xrandr, so this adds no real capability.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card*-HDMI-A-*", \
  RUN+="/usr/bin/chgrp plugdev /sys%p/status", RUN+="/usr/bin/chmod g+w /sys%p/status"
