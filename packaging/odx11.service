# opendisplay-x11 user service. Started at login by /etc/xdg/autostart/opendisplay-x11.desktop
# (`odx11 autostart`), which first hands the session's DISPLAY to the user manager — desktops
# do not reliably activate graphical-session.target, so there is no [Install] section.
[Unit]
Description=OpenDisplay for X11: iPad as a second monitor over USB
Documentation=file:///usr/share/doc/opendisplay-x11/README.md

[Service]
Type=simple
ExecStart=/usr/bin/odx11 daemon
# Every exit path, SIGKILL included, unforces the connector: a connector left forced on is an
# invisible monitor that swallows windows. No root needed (udev rule).
ExecStopPost=/usr/bin/odx11 release
Restart=on-failure
RestartSec=2
# 75 = restarting onto a new version after a package upgrade (odx11/upgrade.py): a planned
# exit, so not logged as a failure, but always restarted.
SuccessExitStatus=75
RestartForceExitStatus=75
# 78 = configuration problem (no spare port, not permitted): retrying cannot fix it.
RestartPreventExitStatus=78
