[Desktop Entry]
Type=Application
Name=OpenDisplay for X11
Comment=Extends the desktop to an iPad running OpenDisplay when it is plugged in (unofficial sender)
Exec=/usr/bin/odx11 autostart
NoDisplay=true
X-GNOME-Autostart-enabled=true
