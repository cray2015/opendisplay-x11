#!/bin/bash
# odx11-connector — the project's entire privileged surface (PROJECT_SPEC.md §8.5).
# Runs as root via sudoers NOPASSWD. Acts only on the connector named in the
# root-owned allowlist /etc/odx11/connector, and writes only that connector's
# sysfs status and debugfs EDID override.
#
#   odx11-connector on            force the connector connected
#   odx11-connector detect        return it to hotplug detection
#   odx11-connector edid < blob   set its EDID override (bytes on stdin, never a path:
#                                 root must not read files on the caller's behalf)
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ALLOW=/etc/odx11/connector
die() { echo "odx11-connector: $*" >&2; exit 2; }

[[ -r $ALLOW ]] || die "missing $ALLOW"
conn=$(tr -d '[:space:]' < "$ALLOW")
[[ $conn =~ ^card([0-9]+)-(HDMI-A-[0-9]+)$ ]] || die "$ALLOW must hold cardN-HDMI-A-M, got '$conn'"
dri=${BASH_REMATCH[1]}
kconn=${BASH_REMATCH[2]}
status=/sys/class/drm/$conn/status
[[ -w $status ]] || die "no such connector $conn"

case "${1:-}" in
  on|detect)
    [[ $# -eq 1 ]] || die "usage: $0 on|detect|edid"
    echo "$1" > "$status"
    ;;
  edid)
    [[ $# -eq 1 ]] || die "usage: $0 edid < blob"
    target=/sys/kernel/debug/dri/$dri/$kconn/edid_override
    [[ -w $target ]] || die "no debugfs EDID override at $target"
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    head -c 32769 > "$tmp"
    size=$(stat -c %s "$tmp")
    (( size >= 128 && size <= 32768 && size % 128 == 0 )) || die "EDID must be 128..32768 bytes in 128-byte blocks, got $size"
    [[ $(head -c 8 "$tmp" | od -An -tx1 | tr -d ' \n') == 00ffffffffffff00 ]] || die "not an EDID (bad header)"
    cat "$tmp" > "$target"
    ;;
  *)
    die "usage: $0 on|detect|edid"
    ;;
esac
